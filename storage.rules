rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // 1. Permite que cualquier hermano lea los libros desde la app
      allow read: if true;

      // 2. Solo tú (con tu correo) puedes subir o borrar archivos
      allow write: if request.auth != null &&
                   (request.auth.token.email == 'aroncithoper@gmail.com' ||
                    request.auth.token.email == 'e_perezleon@hotmail.com');
    }
  }
}
